# Le Cénacle - variables d'environnement
#
# Copier ce fichier en .env à la racine du backend, puis remplir les valeurs.
# Le fichier .env contient des secrets et ne doit jamais être versionné.
#
# Les quatre variables ci-dessous sont les seules lues par le code applicatif
# (relevé exhaustif : grep -rn "process.env." src/ prisma/).


# --- Base de données ---------------------------------------------------------
# Chaîne de connexion PostgreSQL, consommée par l'adaptateur Prisma
# (src/lib/prisma.js). Obligatoire : sans elle, aucune requête ne part.
# Le conteneur PostgreSQL du projet expose le port 5433 sur l'hôte.
DATABASE_URL="postgresql://UTILISATEUR:MOT_DE_PASSE@localhost:5433/cenacle?schema=public"


# --- Serveur HTTP ------------------------------------------------------------
# Port d'écoute d'Express (src/index.js). Optionnel : 3000 par défaut.
PORT=3000


# --- Authentification --------------------------------------------------------
# Clé de signature et de vérification des jetons JWT
# (src/routes/auth.js pour la signature, src/middlewares/auth.js pour la
# vérification). Obligatoire, y compris pour la suite de tests qui signe ses
# propres jetons.
# Générer une valeur aléatoire, par exemple : openssl rand -hex 32
JWT_SECRET="A_REMPLACER_PAR_UNE_VALEUR_ALEATOIRE"


# --- Hachage des mots de passe -----------------------------------------------
# Coût bcrypt. Optionnel, mais les valeurs par défaut du code diffèrent selon
# le contexte : 4 dans les tests (src/routes/__tests__/auth.test.js et
# users.test.js) pour ne pas les ralentir, 12 dans le seed
# (prisma/seedData.ts).
# En production, ne pas descendre sous 12.
BCRYPT_ROUNDS=12
